node_modules
dist
dist-ssr
# Phase 6 — compiled MCP server bundle. Regenerated by
# `npm run build:bin` and shipped via `npm publish` (the
# package.json `files` allowlist includes dist-bin/). Not
# committed because the bundled file would churn on every
# engine change.
dist-bin
# Roadmap M3.1 — bundled audit-engine library. Regenerated via
# `npm run build:audit-lib`. The browser extension + bookmarklet
# (M3.2 onwards) consume it; nothing in src/ depends on it, so it
# never needs to live in git.
dist-audit-lib
.vite
.cache
.DS_Store
*.log
.env
.env.local
.env.*.local
coverage
.tsbuildinfo
*.tsbuildinfo
.audit-cache
audit-results.log

# Phase 4.1 — Playwright artefacts. Snapshots themselves are
# committed under tests/visual/__snapshots__/; reports + traces +
# test-results are ephemeral CI output.
playwright-report
test-results
.playwright

# Phase 4.2 — Lighthouse CI dumps reports + manifest into this dir.
.lighthouseci

# Roadmap M2.1 (2/3) — press-kit screenshots are generated on demand
# via `npm run press:shots`. Keeping them out of git avoids ~7 MB of
# PNG churn on every fixture tweak; the README + on-disk presence
# document how to regenerate.
public/press/screenshots/

# Roadmap M2.1 (3/3) — one-pager PDF regenerated via
# `npm run press:pdf`. Binary output, no value in git history.
public/press/one-pager.pdf

